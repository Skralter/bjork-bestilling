<%- include('../partials/header') %>
<section class="auth-card">
  <h1>Logg inn</h1>
  <p class="muted">Logg inn med brukernavnet og passordet ditt. Kontoen må være godkjent før du slipper inn.</p>
  <% if (typeof loggedOutMessage !== 'undefined' && loggedOutMessage) { %>
    <div class="alerts">
      <div class="alert alert-success"><%= loggedOutMessage %></div>
    </div>
  <% } %>
  <% if (typeof errors !== 'undefined' && errors.length) { %>
    <div class="alerts">
      <% errors.forEach(function(error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% }) %>
    </div>
  <% } %>
  <form class="form-grid" method="post" action="/auth/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>
      Brukernavn
      <input type="text" name="username" required value="<%= formData.username %>" autocomplete="username">
    </label>
    <label>
      Passord
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button class="btn" type="submit">Logg inn</button>
  </form>
  <p class="footer-note">Har du ikke konto ennå? <a href="/auth/register">Registrer konto</a>.</p>
</section>
<%- include('../partials/footer') %>
