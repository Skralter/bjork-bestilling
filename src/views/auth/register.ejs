<%- include('../partials/header') %>
<section class="auth-card">
  <h1>Registrer konto</h1>
  <p class="muted">Registreringen sendes til administrator for godkjenning før du kan logge inn.</p>
  <% if (typeof errors !== 'undefined' && errors.length) { %>
    <div class="alerts">
      <% errors.forEach(function(error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% }) %>
    </div>
  <% } %>
  <form class="form-grid" method="post" action="/auth/register">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>
      Fullt navn
      <input type="text" name="fullName" required value="<%= formData.fullName %>" autocomplete="name">
    </label>
    <label>
      Brukernavn
      <input type="text" name="username" required value="<%= formData.username %>" autocomplete="username">
    </label>
    <label>
      Passord
      <input type="password" name="password" required autocomplete="new-password">
    </label>
    <label>
      Bekreft passord
      <input type="password" name="confirmPassword" required autocomplete="new-password">
    </label>
    <button class="btn" type="submit">Registrer konto</button>
  </form>
  <p class="footer-note">Har du allerede konto? <a href="/auth/login">Logg inn her</a>.</p>
</section>
<%- include('../partials/footer') %>
