<%- include('../partials/header') %>
<section class="hero">
  <h1>Masseinnlegg produkter</h1>
  <p>Legg inn ett øl per linje: bryggeri; ølnavn. Bare bryggeri og ølnavn er påkrevd.</p>
</section>

<section class="card">
  <% if (typeof errors !== 'undefined' && errors.length) { %>
    <div class="alerts">
      <% errors.forEach(function(error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% }) %>
    </div>
  <% } %>

  <form class="form-grid" method="post" action="/admin/products/bulk">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>
      Produktliste
      <textarea name="rows" required rows="10" aria-describedby="bulk-products-help" placeholder="Tree House; Julius&#10;Tree House; Green&#10;Lervig; Lucky Jack"><%= formData.rows || '' %></textarea>
    </label>
    <% if (hasGoogleImageSearchCredentials) { %>
      <label style="display:flex; gap:0.75rem; align-items:center; font-weight:500;">
        <input type="checkbox" name="autoFetchImage">
        Bruk bare Google-bilde ved tydelig treff, ellers bruk plassholder
      </label>
    <% } %>
    <div class="button-row">
      <button class="btn" type="submit">Legg inn produkter</button>
      <a class="btn-secondary" href="/admin/products">Tilbake</a>
    </div>
  </form>

  <div id="bulk-products-help" class="footer-note">
    <p>Du kan også fylle ut flere felt i denne rekkefølgen: bryggeri; ølnavn; beskrivelse; pris; lager; bestillingstrinn; bestillingsfrist; status.</p>
    <p>Eksempel med flere felt: Lervig; Lucky Jack; Frisk pale ale; 59; 48; 4</p>
    <p>Uten flere felt lagres ølet med tom beskrivelse, uten pris, lagergrense eller bestillingsfrist, bestillingstrinn 1 og status ACTIVE. Status kan være ACTIVE, INACTIVE, SOLD_OUT eller ARCHIVED.</p>
  </div>
</section>
<%- include('../partials/footer') %>
