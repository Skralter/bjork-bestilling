<%- include('../partials/header') %>
<section class="hero">
  <h1>Masseinnlegg produkter</h1>
  <p>Fyll inn bryggerinavn og ølnavn. Du kan legge inn flere øl fra samme bryggeri ved å skrive ett ølnavn per linje.</p>
</section>

<section class="card">
  <% if (typeof errors !== 'undefined' && errors.length) { %>
    <div class="alerts">
      <% errors.forEach(function(error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% }) %>
    </div>
  <% } %>

  <form class="form-grid" method="post" action="/admin/products/bulk">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>
      Bryggerinavn
      <input type="text" name="breweryName" required value="<%= formData.breweryName || '' %>" placeholder="For eksempel Tree House">
    </label>
    <label>
      Ølnavn
      <textarea name="rows" required rows="10" aria-describedby="bulk-products-help" placeholder="Julius&#10;Green&#10;Haze"><%= formData.rows || '' %></textarea>
    </label>
    <% if (hasGoogleImageSearchCredentials) { %>
      <label style="display:flex; gap:0.75rem; align-items:center; font-weight:500;">
        <input type="checkbox" name="autoFetchImage">
        Bruk bare Google-bilde ved tydelig treff, ellers bruk plassholder
      </label>
    <% } %>
    <div class="button-row">
      <button class="btn" type="submit">Legg inn produkter</button>
      <a class="btn-secondary" href="/admin/products">Tilbake</a>
    </div>
  </form>

  <p id="bulk-products-help" class="footer-note">Skriv ett ølnavn per linje. Alle ølene får bryggerinavnet over. Beskrivelse, pris og lager kan fylles ut ved å redigere ølene etterpå.</p>
</section>
<%- include('../partials/footer') %>
