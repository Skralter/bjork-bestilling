<!DOCTYPE html>
<html lang="nb">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> | Bjørk Bestilling</title>
    <link rel="stylesheet" href="/css/styles.css">
    <script defer src="/js/app.js"></script>
  </head>
  <body>
    <% if (currentUser) { %>
      <header class="topbar">
        <div class="page-shell topbar-inner">
          <a class="brand" href="<%= currentUser.role === 'ADMIN' ? '/admin' : '/products' %>">Bjørk<span>Bestilling</span></a>
          <button class="nav-toggle" type="button" aria-label="Åpne meny" aria-expanded="false" data-nav-toggle>Meny</button>
          <nav class="nav-menu" aria-label="Hovedmeny" data-nav-menu>
            <a class="nav-link <%= currentPath.startsWith('/products') ? 'active' : '' %>" href="/products">Øl</a>
            <a class="nav-link <%= currentPath === '/products/my-orders' ? 'active' : '' %>" href="/products/my-orders">Mine bestillinger</a>
            <a class="nav-link <%= currentPath.startsWith('/account') ? 'active' : '' %>" href="/account">Min konto</a>
            <% if (currentUser.role === 'ADMIN') { %>
              <a class="nav-link <%= currentPath === '/admin' ? 'active' : '' %>" href="/admin">Admin</a>
              <a class="nav-link <%= currentPath.startsWith('/admin/products') ? 'active' : '' %>" href="/admin/products">Varer</a>
              <a class="nav-link <%= currentPath.startsWith('/admin/orders') ? 'active' : '' %>" href="/admin/orders">Bestillinger</a>
              <a class="nav-link <%= currentPath.startsWith('/admin/users') ? 'active' : '' %>" href="/admin/users">Brukere</a>
            <% } %>
            <span class="user-chip"><%= currentUser.fullName %> · <%= currentUser.role %></span>
            <form method="post" action="/auth/logout">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="nav-logout" type="submit">Logg ut</button>
            </form>
          </nav>
        </div>
      </header>
    <% } %>
    <main class="<%= currentUser ? 'content page-shell' : 'auth-layout' %>">
      <% if (flash.success.length || flash.error.length) { %>
        <div class="alerts" aria-live="polite">
          <% flash.success.forEach(function(message) { %>
            <div class="alert alert-success"><%= message %></div>
          <% }) %>
          <% flash.error.forEach(function(message) { %>
            <div class="alert alert-error"><%= message %></div>
          <% }) %>
        </div>
      <% } %>
